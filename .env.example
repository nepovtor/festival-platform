# Public canonical URL and the only allowed browser origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_ORIGIN=http://localhost:3000

# SQLite storage. The default is ./data/festival.sqlite.
FESTIVAL_DB_FILE=./data/festival.sqlite

# Resend. Leave the key/from empty locally to store registrations without sending.
RESEND_API_KEY=
EMAIL_FROM=Lay's Festival <festival@example.com>
EMAIL_REPLY_TO=hello@example.com
# Optional absolute logo URL for email clients that cannot resolve the public URL.
EMAIL_LOGO_URL=

# Optional Google Calendar UTC timestamps, format YYYYMMDDTHHMMSSZ.
# Defaults match 16 August 2026, 12:00–22:00 Europe/Minsk (UTC+3).
FESTIVAL_CALENDAR_START=20260816T090000Z
FESTIVAL_CALENDAR_END=20260816T190000Z

# Optional analytics. Leave empty to ship without third-party trackers.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# No default admin account is provided. Choose a unique username.
ADMIN_USERNAME=
# Generate with:
# node -e "import('bcryptjs').then(({hash})=>hash('your-long-password',12).then(console.log))"
# Keep the bcrypt hash single-quoted in .env so Docker Compose does not expand $.
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=
